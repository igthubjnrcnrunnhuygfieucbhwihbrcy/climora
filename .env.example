# Climora Configuration
CLIMORA_DEBUG=false

# Database
CLIMORA_DATABASE_URL=postgresql+asyncpg://climora:climora@localhost:5432/climora
CLIMORA_DATABASE_SYNC_URL=postgresql://climora:climora@localhost:5432/climora

# Redis
CLIMORA_REDIS_URL=redis://localhost:6379/0

# KNMI Data Platform (free registration: https://developer.dataplatform.knmi.nl/)
CLIMORA_KNMI_API_KEY=

# Meteostat (optional, via RapidAPI)
CLIMORA_METEOSTAT_API_KEY=

# Location (default: Almelo, NL)
CLIMORA_DEFAULT_LATITUDE=52.3567
CLIMORA_DEFAULT_LONGITUDE=6.6683
CLIMORA_DEFAULT_LOCATION_NAME=Almelo

# Local weather station
CLIMORA_LOCAL_STATION_ENABLED=false
CLIMORA_LOCAL_STATION_URL=

# Collector intervals (minutes)
CLIMORA_COLLECTOR_INTERVAL_OPENMETEO=15
CLIMORA_COLLECTOR_INTERVAL_KNMI=60
CLIMORA_COLLECTOR_INTERVAL_LOCAL=5
